# Copy to ops/local/deployment.env and replace placeholders.
# Explicit environment values take precedence over these local defaults.
if [[ "${CALENDAR_SSH_TARGET+x}" != x ]]; then CALENDAR_SSH_TARGET='root@calendar.example.com'; fi
if [[ "${CALENDAR_SSH_IDENTITY+x}" != x ]]; then CALENDAR_SSH_IDENTITY="$HOME/.ssh/calendar"; fi
if [[ "${CALENDAR_BACKEND_ORIGIN+x}" != x ]]; then CALENDAR_BACKEND_ORIGIN='https://calendar.example.com'; fi
# On a shared host, name the additional service whose process must remain unchanged.
if [[ "${CALENDAR_PROTECTED_SERVICE+x}" != x ]]; then CALENDAR_PROTECTED_SERVICE='caddy.service'; fi
