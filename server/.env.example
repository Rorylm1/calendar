HOST=127.0.0.1
PORT=8787
CALENDAR_DB_PATH=./data/calendar.sqlite
# Generate separate random values locally. Do not reuse these placeholders.
CALENDAR_SERVICE_TOKEN=
# 32 random bytes, base64 encoded. Back up securely, separately from the database.
CALENDAR_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/gmail/callback
GMAIL_ALLOWED_EMAIL=owner@example.com
# Pace all Gmail reads, including thread/attachment context and retries.
GMAIL_REQUEST_INTERVAL_MS=1000
OPENROUTER_API_KEY=
AI_TRIAGE_MODEL=google/gemini-3.5-flash-lite
AI_EXTRACTION_MODEL=google/gemini-3.6-flash
AI_MONTHLY_BUDGET_USD=5
# USD per one million tokens. Set these when changing models.
AI_TRIAGE_INPUT_USD=0.30
AI_TRIAGE_OUTPUT_USD=2.50
AI_EXTRACTION_INPUT_USD=0.75
AI_EXTRACTION_OUTPUT_USD=3.75

# Optional official WhatsApp receiver spike. All four enable /webhooks/whatsapp.
# No access token: this receiver does not send replies or fetch media.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OWNER_SENDER_ID=
WHATSAPP_PHONE_NUMBER_ID=

# Public backend origin for private read-only calendar subscriptions (no trailing slash).
# Leave empty to disable link creation. Possession of the generated URL grants read access.
CALENDAR_PUBLIC_ORIGIN=
# Optional opt-in review alerts. Generate once with web-push; keep the private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Public HTTPS contact page or mailto contact for the push service.
VAPID_SUBJECT=

# Enable interpretation of received WhatsApp captures after receiver verification.
WHATSAPP_PROCESSING_ENABLED=false
# Meta messaging token for image downloads; not required for text receiving.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CONTACT_NUMBER=
